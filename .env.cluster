# ==============================================================================
# MechaDetect Cluster Environment (.env.cluster)
# ==============================================================================
# Copy this file to .env on the 4x RTX 4090 cluster instance before running:
#   cp .env.cluster .env
#
# Assumes:
# - Hardware: Exactly 4x NVIDIA GeForce RTX 4090 (24GB VRAM each)
# - OS: Linux (Ubuntu 22.04 LTS recommended)
# - Fast NVMe mount for DATA_ROOT and OUTPUT_ROOT (minimum 200GB free; 300GB+ preferred)
# - uv installed (curl -LsSf https://astral.sh/uv/install.sh | sh)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime Storage Paths (Must be absolute, on fast persistent NVMe)
# ------------------------------------------------------------------------------
TECHJAM_RUNTIME_ROOT=/workspace/techjam26-runtime
TECHJAM_DATA_ROOT=/workspace/techjam26-runtime/data
TECHJAM_HF_HOME=/workspace/techjam26-runtime/huggingface
TECHJAM_OUTPUT_ROOT=/workspace/techjam26-runtime/outputs

# Export standard cache paths to point to NVMe
HF_HOME=/workspace/techjam26-runtime/huggingface
TORCH_HOME=/workspace/techjam26-runtime/torch_cache

# ------------------------------------------------------------------------------
# 2. Hugging Face Authentication & Target Repositories
# ------------------------------------------------------------------------------
# Account zye2 credentials (required for gated sources, data upload, model upload)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Remote repositories for gated pipeline deliverables
TECHJAM_DATA_REPO=zye2/tj-data
TECHJAM_MODEL_REPO=zye2/mechadetect-models

# ------------------------------------------------------------------------------
# 3. Git & Branch Tracking
# ------------------------------------------------------------------------------
TECHJAM_GIT_BRANCH=training/production-4x4090
# Set expected SHA if strict commit verification is desired before launch
TECHJAM_EXPECTED_GIT_SHA=

# ------------------------------------------------------------------------------
# 4. Vast.ai Budget Guard & Cost Protection
# ------------------------------------------------------------------------------
# API key for querying instance cost and balance via vastai CLI or curl
VAST_API_KEY=
# Minimum reserve balance retained (pipeline stops and uploads before touching this reserve)
VAST_MIN_BALANCE_RESERVE=5.00
# Explicit balance override (USD) if vastai CLI cannot query balance automatically
TECHJAM_EXPLICIT_BALANCE=
# Instance hourly rate in USD/hour (required for smoke-derived cost projection & $5 reserve enforcement)
VAST_HOURLY_RATE=
# ------------------------------------------------------------------------------
# 5. Multi-GPU Topology & Geometry (4x RTX 4090)
# ------------------------------------------------------------------------------
# Teacher Stage 1 & Stage 2: 4-GPU DDP (GPUs 0,1,2,3)
TEACHER_WORLD_SIZE=4
TEACHER_DDP_PORT=29500

# Student Distillation & ATT Concurrent Track Pools:
# Track A (Small / ViT-S): GPUs 0,1
STUDENT_SMALL_GPUS=0,1
STUDENT_SMALL_PORT=29501

# Track B (Base / ViT-B): GPUs 2,3
STUDENT_BASE_GPUS=2,3
STUDENT_BASE_PORT=29502

# ATT Ports (isolated)
ATT_SMALL_PORT=29503
ATT_BASE_PORT=29504

# ------------------------------------------------------------------------------
# 6. Pipeline Execution & State Machine Controls
# ------------------------------------------------------------------------------
# Path to state machine progress tracker (resumable)
TECHJAM_PIPELINE_STATE=/workspace/techjam26-runtime/outputs/pipeline_state.json
# Calibration rows for static INT8 PTQ (must be disjoint from train/val/test/unseen)
TECHJAM_CALIBRATION_SIZE=4096

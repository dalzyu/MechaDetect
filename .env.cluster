# ==============================================================================
# MechaDetect Training Environment (.env.cluster)
# ==============================================================================
# Copy this file to .env before running:
#   cp .env.cluster .env
#
# Requires Linux, one or more CUDA GPUs with BF16 support, fast persistent
# storage, and uv. The maintained launcher uses one GPU unless GPU_DEVICES lists
# more than one device.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime Storage Paths (Must be absolute, on fast persistent NVMe)
# ------------------------------------------------------------------------------
TECHJAM_RUNTIME_ROOT=/workspace/techjam26-runtime
TECHJAM_DATA_ROOT=/workspace/techjam26-runtime/data
TECHJAM_HF_HOME=/workspace/techjam26-runtime/huggingface
TECHJAM_OUTPUT_ROOT=/workspace/techjam26-runtime/outputs

# Export standard cache paths to point to NVMe
HF_HOME=/workspace/techjam26-runtime/huggingface
TORCH_HOME=/workspace/techjam26-runtime/torch_cache

# ------------------------------------------------------------------------------
# 2. Hugging Face Authentication & Target Repositories
# ------------------------------------------------------------------------------
# Account zye2 credentials (required for gated sources, data upload, model upload)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Remote repositories for gated pipeline deliverables
TECHJAM_DATA_REPO=zye2/tj-data
TECHJAM_MODEL_REPO=zye2/mechadetect-models

# ------------------------------------------------------------------------------
# 3. Git & Branch Tracking
# ------------------------------------------------------------------------------
TECHJAM_GIT_BRANCH=main
# Set expected SHA if strict commit verification is desired before launch
TECHJAM_EXPECTED_GIT_SHA=

# ------------------------------------------------------------------------------
# 4. Optional Vast.ai Budget Metadata
# ------------------------------------------------------------------------------
VAST_API_KEY=
VAST_MIN_BALANCE_RESERVE=5.00
TECHJAM_EXPLICIT_BALANCE=
VAST_HOURLY_RATE=

# ------------------------------------------------------------------------------
# 5. Training Topology
# ------------------------------------------------------------------------------
# Default: one GPU, effective record batch 48, no wall-clock deadline.
# Example DDP override: GPU_DEVICES=0,1
GPU_DEVICES=0
EFFECTIVE_BATCH_SIZE=48
NUM_WORKERS=4
MAX_HOURS=0

# ------------------------------------------------------------------------------
# 6. Pipeline Execution & State Machine Controls
# ------------------------------------------------------------------------------
# Path to state machine progress tracker (resumable)
TECHJAM_PIPELINE_STATE=/workspace/techjam26-runtime/outputs/pipeline_state.json
# Calibration rows for static INT8 PTQ (must be disjoint from train/val/test/unseen)
TECHJAM_CALIBRATION_SIZE=4096
